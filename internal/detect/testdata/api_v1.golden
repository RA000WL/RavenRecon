## types

type Category string

type Context struct {
	Assets []asset.Identity `json:"assets"`
	Relationships []asset.Relationship `json:"relationships"`
	Evidence []asset.Evidence `json:"evidence"`
	Technologies []asset.Technology `json:"technologies"`
	Secrets []asset.SecretCandidate `json:"secrets"`
	JavaScript []asset.JavaScript `json:"javascript"`
	Endpoints []asset.Endpoint `json:"endpoints"`
	Config map[string]string `json:"config,omitempty"`
	Logger Logger `json:"-"`
	Clock runtime.Clock `json:"-"`
}

type Cost string

type Detector func(context.Context, *Context) ([]asset.Finding, error)

type EngineConfig struct {
	Registry *Registry
	Concurrency int
	QueueSize int
	Timeout time.Duration
	Rate float64
	Burst int
	Clock runtime.Clock
	Cache cache.Cache
	Logger Logger
	Config map[string]string
	Emit func(context.Context, asset.Finding) error
	Metrics *Metrics
}

type FindingPriority string

type FindingStatus string

type LogEntry struct {
	Level LogLevel `json:"level"`
	Rule string `json:"rule"`
	Message string `json:"message"`
}

type LogLevel string

type Logger interface { Log(LogLevel, string, string) }

type Outcome string

type Registry struct {
}

type Report struct {
	Outcome Outcome `json:"outcome"`
	Rules []RuleResult `json:"rules"`
	Findings []asset.Finding `json:"findings"`
	FindingsTruncated bool `json:"findings_truncated,omitempty"`
	Completed int `json:"completed"`
	Failed int `json:"failed"`
	Cancelled int `json:"cancelled"`
	Skipped int `json:"skipped"`
	CacheHits int `json:"cache_hits"`
	Levels int `json:"levels"`
	Logs []LogEntry `json:"logs,omitempty"`
	LogsDropped int `json:"logs_dropped,omitempty"`
}

type Rule struct {
	ID string `json:"id"`
	Name string `json:"name"`
	Description string `json:"description"`
	Category Category `json:"category"`
	Version string `json:"version"`
	Inputs []RuleInput `json:"inputs"`
	Outputs []RuleOutput `json:"outputs"`
	Dependencies []string `json:"dependencies,omitempty"`
	RequiredAssetTypes []asset.Kind `json:"required_asset_types,omitempty"`
	EstimatedCost Cost `json:"estimated_cost"`
	Timeout time.Duration `json:"timeout"`
	Author string `json:"author"`
	Enabled bool `json:"enabled"`
	Detector Detector `json:"-"`
}

type RuleInput string

type RuleOutput string

type RuleResult struct {
	RuleID string `json:"rule_id"`
	RuleVersion string `json:"rule_version"`
	Status RuleStatus `json:"status"`
	SkipReason string `json:"skip_reason,omitempty"`
	Cached bool `json:"cached,omitempty"`
	Findings int `json:"findings"`
	Err error `json:"-"`
}

type RuleStatus string

type Snapshot struct {
	Assets []asset.Identity `json:"assets,omitempty"`
	Relationships []asset.Relationship `json:"relationships,omitempty"`
	Evidence []asset.Evidence `json:"evidence,omitempty"`
	Technologies []asset.Technology `json:"technologies,omitempty"`
	Secrets []asset.SecretCandidate `json:"secrets,omitempty"`
	JavaScript []asset.JavaScript `json:"javascript,omitempty"`
	Endpoints []asset.Endpoint `json:"endpoints,omitempty"`
}

